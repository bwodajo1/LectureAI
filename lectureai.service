[Unit]
Description=LectureAI Flask backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/lectureai/backend
Environment="ANTHROPIC_API_KEY=REPLACE_ME"
Environment="JWT_SECRET=REPLACE_WITH_RANDOM_SECRET"
Environment="FRONTEND_ORIGIN=http://YOUR_EC2_PUBLIC_IP"
ExecStart=/home/ubuntu/lectureai/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --timeout 120 \
    app:app
Restart=always

[Install]
WantedBy=multi-user.target
